# =====================================================================
# frontend/.env.example — optional settings for the React app
# =====================================================================
# Copy this file to "frontend/.env" only if you need to change a value.
#
# WARNING: Everything in the frontend is PUBLIC (visitors can read it).
# NEVER put an API key or password here. Secrets belong in backend/.env.
#
# Vite only exposes variables that start with "VITE_".

# Address of the FastAPI backend.
# TODO: When you deploy the backend, put its public address here.
VITE_API_URL=http://127.0.0.1:8000

# Show the "Manage" menu link? Set to false on the live website.
# VITE_SHOW_MANAGE=false
