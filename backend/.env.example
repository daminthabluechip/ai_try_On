# =====================================================================
# .env.example  —  TEMPLATE for your .env file (safe to upload to GitHub)
# =====================================================================
# How to use:
#   1. Copy this file and name the copy ".env" (in the same backend folder).
#   2. Put your REAL values in .env.
#   3. Never put real secrets in THIS file — it is uploaded to GitHub.
#
# Format: NAME=value   (no spaces around "=", no quotes needed)


# --- Virtual try-on provider (Genlook) --------------------------------
# TODO: Replace YOUR_API_KEY_HERE with your key from https://platform.genlook.app
#       (it starts with "gk_").
VIRTUAL_TRYON_API_KEY=YOUR_API_KEY_HERE

# Base address of the Genlook Try-On API (from Genlook's official docs).
# TODO: Only change this if you switch to a different provider.
VIRTUAL_TRYON_API_URL=https://api.genlook.app/tryon/v1

# Mock mode = FREE test mode. Genlook returns your photo unchanged and
# charges no credits. Keep "true" while building; set to "false" to
# generate real AI try-on images (uses 1 credit each).
TRYON_MOCK_MODE=true


# --- Cloudinary (cloud storage for GARMENT images) ----------------------
# Optional. If this is empty, garment images are stored on your computer
# in backend/static/products/ instead.
#
# TODO: Get this value from https://console.cloudinary.com/app/settings/api-keys
#       -> copy the "API environment variable" and replace the
#       <your_api_key> and <your_api_secret> parts with your real values.
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# The Cloudinary folder where garment images are stored.
CLOUDINARY_FOLDER=ai-tryon/products


# --- Upload rules -------------------------------------------------------
# Largest photo a user may upload, in megabytes. Genlook's limit is 10 MB.
MAX_UPLOAD_SIZE_MB=10


# --- Product management -------------------------------------------------
# "true" lets the website's "Manage Products" page add/delete products and
# upload garment images. Phase 1 has no admin login, so set this to "false"
# before you put the site online.
ALLOW_PRODUCT_MANAGEMENT=true


# --- Frontend address (for CORS) ---------------------------------------
# The address of the React app. The backend only accepts browser requests
# from this address. Vite's default development address is shown below.
# TODO: When you deploy the frontend, add its real web address here,
#       separated by a comma, e.g. http://localhost:5173,https://my-site.com
FRONTEND_URLS=http://localhost:5173
